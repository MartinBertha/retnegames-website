{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "retnegames-website",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "9001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],

  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "RESEND_API_KEY"
    ]
  }
}